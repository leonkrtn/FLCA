# Adresse der Website (ohne Schrägstrich am Ende). Wird für Links in Mails gebraucht.
NEXT_PUBLIC_SITE_URL=https://flca.vercel.app

# Supabase (Projekt-Einstellungen → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Resend (Domain flcautomotive.de verifizieren)
RESEND_API_KEY=
MAIL_FROM="FLC Automotive <termine@flcautomotive.de>"

# Push-Nachrichten: einmal erzeugen mit `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Gemeinsames Geheimnis für /api/cron/takt (Supabase pg_cron und Vercel Cron). Zufällig, mind. 32 Zeichen.
CRON_SECRET=
